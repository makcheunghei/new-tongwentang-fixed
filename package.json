{
  "name": "new-tongwentang-fixed",
  "version": "2.8.2",
  "description": "新同文堂（修復）係持續維護的繁簡中文轉換瀏覽器擴充功能。",
  "keywords": [
    "browser-extension",
    "chinese",
    "simplified-chinese",
    "traditional-chinese",
    "converter"
  ],
  "author": "t7yang",
  "license": "MIT",
  "scripts": {
    "dev:firefox": "rspack build --mode=development --env vendor=firefox",
    "dev:chromium": "rspack build --mode=development --env vendor=chromium",
    "we:firefox": "web-ext run --config=web-ext-config-firefox.mjs --no-config-discovery",
    "we:chromium": "web-ext run --config=web-ext-config-chrome.mjs --no-config-discovery --target=chromium",
    "test:tsc": "tsc --noEmit",
    "build:firefox": "rspack build --mode=production --env vendor=firefox",
    "build:chromium": "rspack build --mode=production --env vendor=chromium",
    "build:all": "npm run build:firefox && npm run build:chromium",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint --fix",
    "release": "commit-and-tag-version -t '' --packageFiles package.json",
    "update": "ncu -i --format group",
    "we:build": "web-ext build -s dist/firefox",
    "we:sign": "web-ext sign --config=web-ext-config-firefox.mjs --no-config-discovery",
    "prepare": "husky",
    "test:lint": "eslint .",
    "test": "npm run test:tsc && npm run test:lint && npm run test:unit && npm run build:all && npm run test:webext && npm run test:build",
    "build:zip:firefox": "node scripts/package-extension.mjs firefox",
    "build:zip:chromium": "node scripts/package-extension.mjs chromium",
    "test:webext": "web-ext lint -s dist/firefox --no-config-discovery",
    "test:unit": "vitest run",
    "dev:safari": "rspack build --mode=development --env vendor=safari",
    "build:safari": "rspack build --mode=production --env vendor=safari",
    "safari:convert": "npm run build:safari && node ./scripts/safari-convert.mjs",
    "test:build": "node scripts/verify-build.mjs",
    "safari:build:ios": "npm run safari:convert && node scripts/safari-build.mjs ios build",
    "safari:build:macos": "npm run safari:convert && node scripts/safari-build.mjs macos build",
    "safari:build:simulator": "npm run safari:convert && node scripts/safari-build.mjs ios simulator",
    "safari:archive:ios": "npm run safari:convert && node scripts/safari-build.mjs ios archive",
    "safari:export:ios": "node scripts/safari-build.mjs ios export-development",
    "safari:export:appstore": "node scripts/safari-build.mjs ios export-distribution",
    "safari:archive:macos": "npm run safari:convert && node scripts/safari-build.mjs macos archive",
    "safari:export:macos": "node scripts/safari-build.mjs macos export-distribution"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "data-fixer": "5.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "spectre.css": "0.5.9",
    "tongwen-core": "5.0.0-beta-1",
    "webextension-polyfill": "0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.19.1",
    "@eslint/js": "10.0.1",
    "@rspack/cli": "2.2.6",
    "@rspack/core": "2.2.6",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webextension-polyfill": "0.12.6",
    "commit-and-tag-version": "13.2.1",
    "dotenv": "18.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "nano-staged": "1.0.2",
    "npm-check-updates": "23.1.0",
    "prettier": "3.9.8",
    "tongwen-dict": "1.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "web-ext": "10.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makcheunghei/new-tongwentang-fixed.git"
  },
  "bugs": {
    "url": "https://github.com/makcheunghei/new-tongwentang-fixed/issues"
  },
  "homepage": "https://github.com/makcheunghei/new-tongwentang-fixed#readme",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@humanfs/node": "0.17.0",
    "brace-expansion@^1.1.7": "1.1.21",
    "image-size": "2.0.4",
    "web-ext": {
      "addons-linter": "10.13.0"
    },
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  }
}
